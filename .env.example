# Runtime selection
APP_ENV=development
LOG_LEVEL=INFO
MAX_ACTIVE_CALLS=100

# OpenRouter: comma-separated secret environment variable names, never key values in code
OPENROUTER_KEY_ENV_NAMES=OPENROUTER_API_KEY_A,OPENROUTER_API_KEY_B
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_STT_MODEL=
OPENROUTER_TTS_MODEL=

# AWS Bedrock
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=
BEDROCK_INFERENCE_PROFILE_ARN=

# PostgreSQL / S3-compatible production storage
DATABASE_URL=postgresql://voiceai:voiceai@localhost:5432/voiceai
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=voiceai-knowledge
S3_REGION=eu-central-1

# Internal speech services
STT_GRPC_ADDRESS=localhost:50051
TTS_GRPC_ADDRESS=localhost:50052

# Observability
OTEL_SERVICE_NAME=municipal-voiceai
PROMETHEUS_PORT=9090
