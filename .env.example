# Runtime selection
APP_ENV=development
LOG_LEVEL=INFO
MAX_ACTIVE_CALLS=100

# Public browser demo (services/demo, needs `uv sync --extra demo`)
# Region for the Nova 2 Sonic (speech-to-speech) model; credentials come from the boto chain.
DEMO_AWS_REGION=us-east-1
# Hard cap per demo session in seconds; the bot is stopped when it is reached.
DEMO_MAX_SESSION_SECONDS=300
# DynamoDB table for per-call metrics-only reports (no audio, transcripts or IPs), 90-day TTL.
# Unset = reports stay in memory only and a warning is logged per call.
DEMO_CALLS_TABLE=
# Comma-separated browser origins allowed to call /api/offer (CORS).
DEMO_ALLOWED_ORIGINS=https://dibbayajyoti.com,https://voiceai-presentation.vercel.app,http://localhost:3000

# OpenRouter: comma-separated secret environment variable names, never key values in code
OPENROUTER_KEY_ENV_NAMES=OPENROUTER_API_KEY_A,OPENROUTER_API_KEY_B
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_STT_MODEL=
OPENROUTER_TTS_MODEL=

# AWS Bedrock
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=
BEDROCK_INFERENCE_PROFILE_ARN=

# PostgreSQL / S3-compatible production storage
DATABASE_URL=postgresql://voiceai:voiceai@localhost:5432/voiceai
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=voiceai-knowledge
S3_REGION=eu-central-1

# Internal speech services
STT_GRPC_ADDRESS=localhost:50051
TTS_GRPC_ADDRESS=localhost:50052

# Observability
OTEL_SERVICE_NAME=municipal-voiceai
PROMETHEUS_PORT=9090
# Nova 2 Sonic voice: tiffany or matthew (en-US), kiara or arjun (en-IN)
DEMO_VOICE=tiffany
